# Zerodha Kite Connect — from developers.kite.trade
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Must match redirect URL set in your Kite Connect app
# For local testing: http://127.0.0.1:8080/auth/callback
# For production: https://yourdomain.com/auth/callback
KITE_REDIRECT_URL=https://yourdomain.com/auth/callback

# Trade defaults
DEFAULT_EXCHANGE=NSE
DEFAULT_QUANTITY=1

# App login
# Username for the web login page
APP_USERNAME=admin
# Run: python setup_password.py — paste the output here
APP_PASSWORD_HASH=

# Session signing key — run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
